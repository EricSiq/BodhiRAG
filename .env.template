# BodhiRAG Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────

# ── Operating Mode ───────────────────────────────────────────────────────
# Determines feature availability and UI behavior
# Options: demo, local_opensource, hosted_freetier, maintainer_ingest
# - demo: Pre-built corpus, no credentials needed
# - local_opensource: Full local stack with Qwen
# - hosted_freetier: Using free hosted services
# - maintainer_ingest: Corpus build enabled
OPERATING_MODE=demo

# ── LLM Provider ──────────────────────────────────────────────────────────
# Options: mistral (HF API), qwen (local or HF API), template (no model)
LLM_PROVIDER=mistral

# ── HF Inference API ──────────────────────────────────────────────────────
# Required for Mistral or Qwen via HF Inference API
# Get your token at: https://huggingface.co/settings/tokens
# Set as HF Space Secret: Settings → Repository secrets → HF_TOKEN
HF_TOKEN=

# ── Qwen Model (Optional) ─────────────────────────────────────────────────
# Specify Qwen model variant
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# For local Qwen (requires transformers, torch):
# QWEN_LOCAL_ENABLED=true
# QWEN_LOCAL_PATH=/path/to/local/model

# ── Neo4j Knowledge Graph (Optional) ─────────────────────────────────────
# Without these, BodhiRAG runs in literature-only mode (still functional)
# Free tier: https://neo4j.com/cloud/aura/
# Format: bolt://xxx.databases.neo4j.io:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Use read-only credentials for public deployments
NEO4J_READ_ONLY=true

# ── ChromaDB Path (Optional) ──────────────────────────────────────────────
# Default: /tmp/chroma_db (always writable on HF Spaces)
# CHROMA_PATH=/tmp/chroma_db

# ── Corpus Build Tracking (Optional) ──────────────────────────────────────
# Specify corpus build ID for provenance tracking
# CORPUS_BUILD_ID=

# ── Embedding Model (Optional) ────────────────────────────────────────────
EMBEDDING_MODEL=ibm/granite-embedding-30m-english

# ── Timeouts and Limits (Optional) ────────────────────────────────────────
# REQUEST_TIMEOUT=90
# EMBEDDING_TIMEOUT=30
# GENERATION_TIMEOUT=120
# MAX_RETRIES=3

# ── Query Limits (Optional) ───────────────────────────────────────────────
# MAX_QUERY_LENGTH=1000
# MAX_HISTORY_SIZE=20
# MAX_RETRIEVED_CHUNKS=10

# ── Ingestion Mode (Advanced) ─────────────────────────────────────────────
# Only effective when OPERATING_MODE=maintainer_ingest
# INGESTION_ENABLED=false
